# 复制为 deploy/.env（被 gitignore 排除，不会进仓库）。全部可选——不建也能跑。
# backend-compose.yml 会读取这里的变量。

# /ingest（插件微博/X，走公网）与 /api/analysis/run（AI 分析触发）的校验密钥。
# 设了之后：插件要在「设置 → Ingest Token」填同样的值；
# 前端 nginx 会用同一个值服务端注入 X-Ingest-Token（方案A，浏览器不可见）——
# 所以设置/修改本值后【后端和前端容器都要重建】。留空 = 不校验。
INGEST_TOKEN=

# /ingest/wemp（公众号 webhook，同机内网）的独立密钥，与 INGEST_TOKEN 互不影响。
# 留空 = 不校验（保持现有免 token 的公众号链路）。除非你也想保护它，否则不用填。
WEMP_TOKEN=

# 前端跨域来源，逗号分隔；* = 放开（开发/内网）。生产可填前端域名。
CORS_ORIGINS=*

# ===== AI 热点态势分析（DeepSeek）=====
# ⚠️ DeepSeek API key 的唯一存放位置就是这里（https://platform.deepseek.com 申请，sk- 开头）。
#    仅注入后端容器；严禁写进前端代码、前端容器或任何接口响应。不填则 AI 分析功能不启用。
DEEPSEEK_API_KEY=

# 以下可不填，用默认值：
# DEEPSEEK_MODEL=deepseek-chat  # 官方对话模型（V3），走 https://api.deepseek.com/chat/completions
# ANALYSIS_AUTO_HOUR=8          # 每天自动分析的小时（北京时间，分钟随机 20~40，即约 08:30）
# ANALYSIS_HOURS=24             # 每次分析覆盖最近多少小时
# ANALYSIS_MANUAL_LIMIT=10      # 手动分析每日上限（自动的 1 次不占用）
# ANALYSIS_AUTO_ENABLED=true    # 设为 false 关闭每日自动分析
